{:paths ["src" "resources"]
 :deps
 {cprop/cprop {:mvn/version "0.1.21"}
  ring/ring {:mvn/version "1.14.1"}
  org.clojars.frozenlock/ring-multipart-nodeps {:mvn/version "1.3.0"}
  com.rpl/specter {:mvn/version "1.1.4"}
  askonomm/ruuter {:git/url "https://git.nmm.ee/asko/ruuter.git"
                   :git/tag "v2.1.0"
                   :git/sha "d9f8ef2"}
  ring/ring-anti-forgery
  {:git/url "https://github.com/m3tti/ring-anti-forgery"
   :git/sha "4e226df604dca13d5c93be4d4900367a64f5963e"}}
 :tasks
 {:init (def os (System/getProperty "os.name"))
  tailwindcss {:doc "Generate tailwindcss out file"
               :task (case os
                       "Linux" (shell "tailwindcss -i resources/tw_input.css -o resources/public/css/tw_out.css")
                       "Mac OS X" (shell "npx @tailwindcss/cli -i resources/tw_input.css -o resources/public/css/tw_out.css")
                       "Do nothing")}
  start-web {:doc "Start web application"
             :depends [tailwindcss]
             :task core/-main}
  db-seed {:doc "Seed data: default admin user"
           :task database.user/default-user}}}
