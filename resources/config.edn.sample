{:app-name "minweb"
 :title "Min's Web Application"
 :dtlv-opts "db/dtlv.db"
 :page-size 20
 :init-email "admin@example.com"
 :init-name "Admin"
 :init-role :admin
 :init-pwd "change-me-after-first-login"
 :company "Min's Web"
 :rate-limit-max-attempts 5
 :rate-limit-lockout-minutes 15
 ;; Only enable behind a reverse proxy you control. When true, X-Forwarded-For
 ;; / X-Real-IP are trusted for rate-limit keying; any client can forge them,
 ;; so leaving it false keys the limiter on the real socket address.
 :trust-proxy-headers false}
